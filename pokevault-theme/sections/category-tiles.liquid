{% doc %}
  Renders two large category tiles (Sealed Products & Protections) with images and links.
{% enddoc %}

<section class="category-tiles">
  <div class="container">
    <div class="tiles-grid">
      <!-- Tile 1: Sealed Products -->
      <a href="/collections/produits-scelles" class="category-tile">
        <div class="tile-content">
          <h2>{{ 'categories.sealed_products' | t }}</h2>
          <p>{{ 'categories.sealed_description' | t }}</p>
          <span class="tile-cta">{{ 'categories.explore' | t }} →</span>
        </div>
        <div class="tile-background sealed-bg"></div>
      </a>

      <!-- Tile 2: Protections -->
      <a href="/collections/protections" class="category-tile">
        <div class="tile-content">
          <h2>{{ 'categories.protections' | t }}</h2>
          <p>{{ 'categories.protections_description' | t }}</p>
          <span class="tile-cta">{{ 'categories.explore' | t }} →</span>
        </div>
        <div class="tile-background protections-bg"></div>
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .category-tiles {
    margin: 4rem 0;
  }

  .tiles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .category-tile {
    position: relative;
    height: 400px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: var(--text-primary);
    display: flex;
    align-items: flex-end;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .category-tile:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
  }

  .category-tile:hover .tile-content {
    background: linear-gradient(to top, rgba(14, 12, 10, 0.95), rgba(14, 12, 10, 0.7));
  }

  .category-tile:hover .tile-cta {
    color: var(--yellow);
  }

  .tile-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .sealed-bg {
    background-color: var(--bg-secondary);
    background-image: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%);
  }

  .protections-bg {
    background-color: var(--bg-tertiary);
    background-image: linear-gradient(135deg, var(--bg-tertiary) 0%, var(--bg-secondary) 100%);
  }

  .tile-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 2rem;
    background: linear-gradient(to top, rgba(14, 12, 10, 0.9), rgba(14, 12, 10, 0.5));
    transition: background 0.3s ease;
  }

  .tile-content h2 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .tile-content p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .tile-cta {
    font-family: var(--f-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--yellow);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
  }

  @media (max-width: 768px) {
    .tiles-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .category-tile {
      height: 300px;
    }

    .tile-content {
      padding: 1.5rem;
    }

    .tile-content h2 {
      font-size: 1.25rem;
    }

    .tile-content p {
      font-size: 0.85rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.category_tiles.name",
  "settings": []
}
{% endschema %}
