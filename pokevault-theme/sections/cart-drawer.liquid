{% doc %}
  Cart drawer — slides from the right on desktop, from bottom on mobile.
  Toggle with .active class on #cart-drawer.
{% enddoc %}

<div id="cart-drawer" class="cart-drawer" aria-hidden="true">
  <div class="cart-drawer__overlay" id="cart-overlay"></div>

  <aside class="cart-drawer__panel" role="dialog" aria-label="{{ 'cart.title' | t }}">
    <!-- Header -->
    <div class="cart-drawer__header">
      <div class="cart-drawer__header-left">
        <h2>{{ 'cart.title' | t }}</h2>
        <span class="cart-drawer__count" id="cart-count-drawer">0 {{ 'general.products' | t }}</span>
      </div>
      <button class="cart-drawer__close" id="cart-close" aria-label="{{ 'general.close' | t }}">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Items -->
    <div class="cart-drawer__items" id="cart-items">
      <div class="cart-empty">
        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="opacity:0.3;margin-bottom:1rem">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <p>{{ 'cart.empty' | t }}</p>
      </div>
    </div>

    <!-- Summary + Checkout -->
    <div class="cart-drawer__footer">
      <div class="cart-drawer__summary">
        <div class="summary-row">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span id="cart-subtotal">—</span>
        </div>
        <div class="summary-row summary-row--total">
          <strong>{{ 'cart.total' | t }}</strong>
          <strong id="cart-total">—</strong>
        </div>
        <p class="cart-note">{{ 'cart.note' | t }}</p>
      </div>
      <a href="{{ routes.cart_url }}" class="btn btn--primary btn--lg cart-checkout-btn">
        {{ 'cart.checkout' | t }}
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </aside>
</div>

{% stylesheet %}
  /* ── CART DRAWER — Base ─────────────────────────────────────────── */
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    justify-content: flex-end;
    align-items: stretch;
    visibility: hidden;
    pointer-events: none;
  }

  .cart-drawer.active {
    visibility: visible;
    pointer-events: all;
  }

  /* ── Overlay ────────────────────────────────────────────────────── */
  .cart-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(46, 43, 39, 0.45);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.35s ease;
    cursor: pointer;
  }

  .cart-drawer.active .cart-drawer__overlay {
    opacity: 1;
  }

  /* ── Panel ──────────────────────────────────────────────────────── */
  .cart-drawer__panel {
    position: relative;
    width: 420px;
    max-width: 100vw;
    height: 100%;
    background: var(--bg);
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    z-index: 1;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.12);
  }

  .cart-drawer.active .cart-drawer__panel {
    transform: translateX(0);
  }

  /* ── Header ─────────────────────────────────────────────────────── */
  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .cart-drawer__header-left {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .cart-drawer__header h2 {
    font-family: var(--f-display);
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .cart-drawer__count {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--f-body);
  }

  .cart-drawer__close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .cart-drawer__close:hover {
    border-color: var(--red);
    color: var(--red);
    background: rgba(161, 26, 28, 0.05);
  }

  /* ── Items ──────────────────────────────────────────────────────── */
  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 200px;
    color: var(--text-muted);
    text-align: center;
    font-size: 0.9rem;
  }

  /* Cart line item */
  .cart-line {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
  }

  .cart-line:last-child {
    border-bottom: none;
  }

  .cart-line__img {
    width: 60px;
    height: 60px;
    border-radius: var(--radius);
    background: var(--bg-alt);
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }

  .cart-line__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-line__info {
    flex: 1;
    min-width: 0;
  }

  .cart-line__title {
    font-family: var(--f-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-line__variant {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .cart-line__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-line__price {
    font-family: var(--f-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--red);
  }

  .cart-line__qty {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .qty-btn {
    width: 26px;
    height: 26px;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .qty-btn:hover {
    border-color: var(--red);
    color: var(--red);
  }

  .qty-num {
    font-size: 0.85rem;
    font-weight: 700;
    min-width: 20px;
    text-align: center;
    color: var(--text-primary);
  }

  /* ── Footer (summary + checkout) ───────────────────────────────── */
  .cart-drawer__footer {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
    background: var(--bg);
  }

  .cart-drawer__summary {
    margin-bottom: 1rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .summary-row--total {
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    margin-top: 0.5rem;
    font-size: 1rem;
  }

  .summary-row--total strong {
    color: var(--text-primary);
  }

  .cart-note {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
    line-height: 1.5;
  }

  .cart-checkout-btn {
    width: 100%;
    justify-content: center;
    gap: 0.5rem;
  }

  /* ── Mobile — slide from bottom ─────────────────────────────────── */
  @media (max-width: 768px) {
    .cart-drawer {
      align-items: flex-end;
      justify-content: stretch;
    }

    .cart-drawer__panel {
      width: 100%;
      max-height: 88vh;
      border-left: none;
      border-top: 1px solid var(--border);
      border-radius: 16px 16px 0 0;
      transform: translateY(100%);
      box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.12);
    }

    .cart-drawer.active .cart-drawer__panel {
      transform: translateY(0);
    }
  }
{% endstylesheet %}

{% javascript %}
  function initCartDrawer() {
    const cartToggle = document.getElementById('cart-toggle');
    const cartDrawer = document.getElementById('cart-drawer');
    const cartClose  = document.getElementById('cart-close');
    const overlay    = document.getElementById('cart-overlay');

    function openCart() {
      cartDrawer.classList.add('active');
      cartDrawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      loadCartItems();
    }

    function closeCart() {
      cartDrawer.classList.remove('active');
      cartDrawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (cartToggle) cartToggle.addEventListener('click', function(e) { e.preventDefault(); openCart(); });
    if (cartClose)  cartClose.addEventListener('click', function(e)  { e.preventDefault(); e.stopPropagation(); closeCart(); });
    if (overlay)    overlay.addEventListener('click', closeCart);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeCart();
    });

    // Load cart items from Shopify AJAX API
    function loadCartItems() {
      fetch('/cart.json')
        .then(r => r.json())
        .then(data => {
          updateCartUI(data);
        })
        .catch(err => console.error('Cart fetch error:', err));
    }

    function updateCartUI(cart) {
      const itemsEl  = document.getElementById('cart-items');
      const countEl  = document.getElementById('cart-count');
      const drawerCountEl = document.getElementById('cart-count-drawer');
      const subtotal = document.getElementById('cart-subtotal');
      const total    = document.getElementById('cart-total');
      const count = cart.item_count;
      const formatted = formatMoney(cart.total_price);

      // Header count badge
      if (countEl) {
        countEl.textContent = count;
        countEl.style.display = count > 0 ? 'flex' : 'none';
      }

      // Drawer count label
      if (drawerCountEl) {
        drawerCountEl.textContent = count + ' ' + (count > 1 ? 'produits' : 'produit');
      }

      // Totals
      if (subtotal) subtotal.textContent = formatted;
      if (total)    total.textContent    = formatted;

      // Items list
      if (!itemsEl) return;
      if (count === 0) {
        itemsEl.innerHTML = '<div class="cart-empty"><svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="opacity:0.3;margin-bottom:1rem"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg><p>{{ 'cart.empty' | t }}</p></div>';
        return;
      }

      itemsEl.innerHTML = cart.items.map(item => `
        <div class="cart-line" data-key="${item.key}">
          <div class="cart-line__img">
            ${item.image ? `<img src="${item.image}" alt="${item.product_title}" loading="lazy">` : ''}
          </div>
          <div class="cart-line__info">
            <div class="cart-line__title">${item.product_title}</div>
            ${item.variant_title && item.variant_title !== 'Default Title' ? `<div class="cart-line__variant">${item.variant_title}</div>` : ''}
            <div class="cart-line__footer">
              <div class="cart-line__price">${formatMoney(item.final_line_price)}</div>
              <div class="cart-line__qty">
                <button class="qty-btn" onclick="cartUpdateQty('${item.key}', ${item.quantity - 1})">−</button>
                <span class="qty-num">${item.quantity}</span>
                <button class="qty-btn" onclick="cartUpdateQty('${item.key}', ${item.quantity + 1})">+</button>
              </div>
            </div>
          </div>
        </div>
      `).join('');
    }

    function formatMoney(cents) {
      return (cents / 100).toFixed(2).replace('.', ',') + ' €';
    }

    // Expose globally
    window.cartUpdateQty = function(key, qty) {
      const body = qty <= 0
        ? JSON.stringify({ id: key, quantity: 0 })
        : JSON.stringify({ id: key, quantity: qty });

      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body
      })
        .then(r => r.json())
        .then(data => updateCartUI(data))
        .catch(err => console.error('Cart update error:', err));
    };

    window.addToCart = function(variantId, qty, btn) {
      if (btn) {
        btn.disabled = true;
        btn.textContent = '...';
      }
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: qty || 1 })
      })
        .then(r => r.json())
        .then(() => {
          loadCartItems();
          openCart();
        })
        .catch(err => console.error('Add to cart error:', err))
        .finally(() => {
          if (btn) {
            btn.disabled = false;
            btn.textContent = btn.dataset.originalText || '{{ "product.add_to_cart" | t }}';
          }
        });
    };

    // Init count on page load
    loadCartItems();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCartDrawer);
  } else {
    initCartDrawer();
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": []
}
{% endschema %}
