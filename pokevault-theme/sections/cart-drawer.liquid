{% doc %}
  Renders a slide-out cart drawer (side panel) showing cart items.
  Opens from right side on desktop, from bottom on mobile.
{% enddoc %}

<div id="cart-drawer" class="cart-drawer">
  <div class="cart-drawer__overlay"></div>

  <div class="cart-drawer__panel">
    <!-- Header -->
    <div class="cart-drawer__header">
      <h2>{{ 'cart.title' | t }}</h2>
      <button class="cart-drawer__close" id="cart-close" aria-label="{{ 'general.close' | t }}">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Cart Items List -->
    <div class="cart-drawer__items" id="cart-items">
      <!-- Items will be populated by JavaScript -->
      <div class="cart-empty">{{ 'cart.empty' | t }}</div>
    </div>

    <!-- Cart Summary -->
    <div class="cart-drawer__summary">
      <div class="summary-row">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span id="cart-subtotal">0 €</span>
      </div>
      <div class="summary-row">
        <strong>{{ 'cart.total' | t }}</strong>
        <strong id="cart-total">0 €</strong>
      </div>
      <p class="cart-note">{{ 'cart.note' | t }}</p>
    </div>

    <!-- Checkout Button -->
    <a href="{{ routes.cart_url }}" class="btn btn--primary btn--lg" style="width: 100%;">
      {{ 'cart.checkout' | t }}
    </a>
  </div>
</div>

{% stylesheet %}
  .cart-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 999;
    display: none !important;
    align-items: flex-end;
    visibility: hidden;
  }

  .cart-drawer.active {
    display: flex !important;
    visibility: visible;
  }

  .cart-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }

  .cart-drawer__panel {
    position: relative;
    width: 100%;
    max-width: 400px;
    height: 100%;
    background-color: #FFFFFF;
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    animation: slideInRight 0.3s ease-out;
    z-index: 1000;
  }

  @keyframes slideInRight {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .cart-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .cart-drawer__header h2 {
    font-size: 1.25rem;
    margin: 0;
  }

  .cart-drawer__close {
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
  }

  .cart-drawer__close:hover {
    color: var(--yellow);
  }

  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
  }

  .cart-empty {
    text-align: center;
    color: var(--text-muted);
    padding: 2rem 1rem;
  }

  .cart-drawer__summary {
    padding: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .summary-row strong {
    color: var(--text-primary);
    font-size: 1.1rem;
  }

  .cart-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  /* Mobile — full width drawer */
  @media (max-width: 768px) {
    .cart-drawer {
      display: none !important;
      align-items: flex-end;
    }

    .cart-drawer.active {
      display: flex !important;
    }

    .cart-drawer__panel {
      max-width: none;
      border-left: none;
      border-top: 1px solid var(--border);
      max-height: 80vh;
      animation: slideInUp 0.3s ease-out;
    }

    @keyframes slideInUp {
      from {
        transform: translateY(100%);
      }
      to {
        transform: translateY(0);
      }
    }
  }
{% endstylesheet %}

{% javascript %}
  function initCartDrawer() {
    const cartToggle = document.getElementById('cart-toggle');
    const cartDrawer = document.getElementById('cart-drawer');
    const cartClose = document.getElementById('cart-close');
    const overlay = document.querySelector('.cart-drawer__overlay');

    // Open cart
    if (cartToggle && cartDrawer) {
      cartToggle.addEventListener('click', function(e) {
        e.preventDefault();
        cartDrawer.classList.add('active');
      });
    }

    // Close cart — close button
    if (cartClose && cartDrawer) {
      cartClose.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        cartDrawer.classList.remove('active');
      });
    }

    // Close cart — overlay click
    if (overlay && cartDrawer) {
      overlay.addEventListener('click', function(e) {
        e.preventDefault();
        cartDrawer.classList.remove('active');
      });
    }

    // Update cart count
    function updateCartCount() {
      fetch('/cart.json')
        .then(response => response.json())
        .then(data => {
          const count = data.item_count;
          const countEl = document.getElementById('cart-count');
          if (countEl) {
            if (count > 0) {
              countEl.textContent = count;
              countEl.style.display = 'flex';
            } else {
              countEl.style.display = 'none';
            }
          }
        })
        .catch(err => console.error('Cart count error:', err));
    }

    updateCartCount();
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCartDrawer);
  } else {
    initCartDrawer();
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": []
}
{% endschema %}
