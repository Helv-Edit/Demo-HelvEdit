{% doc %}
  Cart drawer — dark theme PokeVault. Géré par pokevault-home.js via Shopify Cart API.
{% enddoc %}

<div id="cart-drawer" class="cart-drawer">
  <div class="cart-overlay" id="cart-overlay"></div>
  <div class="cart-panel">

    <div class="cart-header">
      <div class="cart-header-left">
        <h2>{{ 'cart.title' | t }}</h2>
        <span class="cart-header-count" id="cart-header-count"></span>
      </div>
      <button class="cart-close" id="cart-close" aria-label="{{ 'general.close' | t }}">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="cart-items" id="cart-items">
      <div class="cart-empty">
        <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <p>{{ 'cart.empty' | t }}</p>
      </div>
    </div>

    <div class="cart-footer">
      <div class="cart-summary">
        <div class="summary-row">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span id="cart-subtotal">—</span>
        </div>
        <div class="summary-row summary-row--total">
          <strong>{{ 'cart.total' | t }}</strong>
          <strong id="cart-total">—</strong>
        </div>
        <div class="cart-ship-note" id="cart-ship-note" style="display:none">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/>
          </svg>
          {{ 'cart.free_shipping' | t }}
        </div>
        <p class="cart-note">{{ 'cart.secure_note' | t }}</p>
      </div>

      <a href="/checkout" class="btn-checkout">
        {{ 'cart.checkout' | t }}
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": []
}
{% endschema %}
