{% liquid
  assign collection_handle = section.settings.collection | default: 'all'
  assign products_col = collections[collection_handle]
%}

<div class="catalog-wrapper">

  <div class="upsell-banner" id="upsell-banner">
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    <div>
      <strong>{{ 'cart.free_shipping_threshold' | t }}</strong>
      <span id="upsell-text"></span>
    </div>
    <div class="ship-progress"><div class="ship-progress-fill" id="ship-fill" style="width:0%"></div></div>
  </div>

  <div class="catalog-top">
    <div class="catalog-filters">
      <button class="filter-tab active" data-cat="all">{{ 'featured_products.filter_all' | t }}</button>
      <button class="filter-tab" data-cat="acrylic">{{ 'featured_products.filter_acrylic' | t }}</button>
      <button class="filter-tab" data-cat="sleeve">{{ 'featured_products.filter_sleeves' | t }}</button>
      <button class="filter-tab" data-cat="toploader">{{ 'featured_products.filter_toploaders' | t }}</button>
    </div>
    <div class="catalog-meta">
      <span class="catalog-count-badge" id="catalog-count">
        {{ products_col.products_count | default: 0 }} {{ 'featured_products.products_label' | t }}
      </span>
    </div>
  </div>

  <div class="products-grid" id="product-grid">
    {%- if products_col -%}
      {%- for product in products_col.products limit: 24 -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p style="color:var(--muted)">{{ 'featured_products.no_products' | t }}</p>
      {%- endfor -%}
    {%- endif -%}
  </div>

</div>

{% javascript %}
/* Filter tabs client-side */
(function() {
  const tabs = document.querySelectorAll('.filter-tab');
  const cards = document.querySelectorAll('.product-card');
  const countEl = document.getElementById('catalog-count');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const cat = tab.dataset.cat;
      let visible = 0;
      cards.forEach(card => {
        const show = cat === 'all' || card.dataset.cat === cat;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (countEl) countEl.textContent = visible + ' produit' + (visible > 1 ? 's' : '');
    });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "{{ 'sections.featured_products.name' | t }}",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection à afficher"
    }
  ],
  "presets": [{ "name": "Catalogue produits" }]
}
{% endschema %}
