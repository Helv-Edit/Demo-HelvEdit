<div class="page-wrapper">

  <div class="promo-banner">
    <div>
      <h3>{{ 'featured_products.promo_title' | t }}</h3>
      <p>{{ 'featured_products.promo_subtitle' | t }}</p>
    </div>
    <div class="banner-perks">
      <div class="perk"><span class="perk-dot"></span> {{ 'featured_products.secure_payment' | t }}</div>
      <div class="perk"><span class="perk-dot"></span> {{ 'featured_products.daily_stock' | t }}</div>
      <div class="perk"><span class="perk-dot"></span> {{ 'featured_products.authentic' | t }}</div>
    </div>
  </div>

  <div class="filter-tabs">
    <a href="{{ routes.all_products_collection_url }}" class="filter-tab active">{{ 'featured_products.filter_all' | t }}</a>
    <a href="/collections/acrylique" class="filter-tab">{{ 'featured_products.filter_acrylic' | t }}</a>
    <a href="/collections/sleeves" class="filter-tab">{{ 'featured_products.filter_sleeves' | t }}</a>
    <a href="/collections/toploaders" class="filter-tab">{{ 'featured_products.filter_toploaders' | t }}</a>
  </div>

  {%- assign featured_collection = collections[section.settings.collection] -%}
  {%- if featured_collection == blank -%}
    {%- assign featured_collection = collections.all -%}
  {%- endif -%}

  <div class="catalog-header">
    <span class="catalog-title">{{ featured_collection.title | default: 'featured_products.filter_all' | t }}</span>
    <span class="catalog-count">{{ featured_collection.products_count }} {{ 'featured_products.products_count' | t }}</span>
  </div>

  <div class="products-grid">
    {%- for product in featured_collection.products limit: 16 -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      <p style="color:var(--text-muted);grid-column:1/-1;text-align:center;padding:3rem 0">
        {{ 'featured_products.no_products' | t }}
      </p>
    {%- endfor -%}
  </div>

</div>

{% schema %}
{
  "name": "Produits vedette",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection à afficher"
    }
  ],
  "presets": [{ "name": "Produits vedette" }]
}
{% endschema %}
