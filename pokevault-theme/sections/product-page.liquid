{% doc %}
  Section page produit — galerie, infos, variantes, add to cart.
{% enddoc %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_image = product.featured_image -%}

<div class="product-page">
  <div class="product-page__inner">

    <!-- ── GALERIE ─────────────────────────────────────────────────────── -->
    <div class="product-gallery">
      <div class="product-gallery__main" id="gallery-main">
        {% if product_image %}
          {{ product_image | image_url: width: 900 | image_tag:
              loading: 'eager',
              class: 'gallery-main-img',
              alt: product_image.alt | default: product.title | escape }}
        {% else %}
          <div class="gallery-placeholder">
            <span>{{ product.title | split: ' ' | first | upcase | truncate: 3, '' }}</span>
          </div>
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="product-gallery__thumbs">
          {% for image in product.images limit: 6 %}
            <button
              class="thumb{% if forloop.first %} thumb--active{% endif %}"
              onclick="pvSwitchImage('{{ image | image_url: width: 900 }}', this)"
            >
              {{ image | image_url: width: 120 | image_tag:
                  loading: 'lazy',
                  alt: image.alt | default: product.title | escape }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- ── INFOS PRODUIT ──────────────────────────────────────────────── -->
    <div class="product-info">

      <div class="product-info__breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a>
        <span>/</span>
        <span>{{ product.type | default: 'product.type_default' | t }}</span>
      </div>

      <h1 class="product-info__title">{{ product.title }}</h1>

      <div class="product-info__price">
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="price-compare">{{ current_variant.compare_at_price | money }}</span>
          <span class="price-current price-current--sale">{{ current_variant.price | money }}</span>
        {% else %}
          <span class="price-current">{{ current_variant.price | money }}</span>
        {% endif %}
      </div>

      {% if product.description != blank %}
        <div class="product-info__description">
          {{ product.description }}
        </div>
      {% endif %}

      <!-- Variantes -->
      {% if product.variants.size > 1 %}
        <div class="product-info__variants">
          {% for option in product.options_with_values %}
            <div class="variant-group">
              <label class="variant-group__label">{{ option.name }}</label>
              <div class="variant-group__options">
                {% for value in option.values %}
                  <button
                    class="variant-option{% if option.selected_value == value %} variant-option--active{% endif %}"
                    onclick="pvSelectVariant('{{ option.name }}', '{{ value }}', this)"
                  >{{ value }}</button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Stock indicator -->
      <div class="product-info__stock">
        {% if current_variant.available %}
          <span class="stock-badge stock-badge--in">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor"><circle cx="4" cy="4" r="4"/></svg>
            {{ 'product.in_stock' | t | default: 'En stock' }}
          </span>
        {% else %}
          <span class="stock-badge stock-badge--out">{{ 'product.out_of_stock' | t }}</span>
        {% endif %}
      </div>

      <!-- Form Add to Cart -->
      {% form 'product', product, id: 'product-form', class: 'product-form' %}
        <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" value="1">

        <button
          type="submit"
          class="btn-add-cart"
          id="add-to-cart"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {% if current_variant.available %}
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
            </svg>
            {{ 'product.add_to_cart' | t }}
          {% else %}
            {{ 'product.out_of_stock' | t }}
          {% endif %}
        </button>

      {% endform %}

      <!-- Garanties produit -->
      <div class="product-guarantees">
        <div class="guarantee-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>
          </svg>
          {{ 'product.guarantee_uv' | t | default: 'Protection UV 99%' }}
        </div>
        <div class="guarantee-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v3h-7V8z"/>
            <circle cx="5.5" cy="18.5" r="1.5"/><circle cx="18.5" cy="18.5" r="1.5"/>
          </svg>
          {{ 'product.guarantee_shipping' | t | default: 'Livraison sécurisée France' }}
        </div>
        <div class="guarantee-item">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
          </svg>
          {{ 'product.guarantee_fit' | t | default: 'Sur mesure pour chaque format' }}
        </div>
      </div>

    </div>
  </div>

  <!-- ── PRODUITS ASSOCIÉS ─────────────────────────────────────────────── -->
  {%- assign related_tag = product.tags | first -%}
  {%- assign related_products = collections.all.products | where: 'available', true -%}
  <div class="related-products">
    <h2 class="related-products__title">{{ 'product.related' | t | default: 'Vous aimerez aussi' }}</h2>
    <div class="products-grid">
      {%- for p in related_products limit: 4 -%}
        {%- unless p.id == product.id -%}
          {% render 'product-card', product: p %}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .product-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
  }

  .product-page__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-bottom: 5rem;
  }

  /* ── Galerie ── */
  .product-gallery__main {
    aspect-ratio: 1;
    background: #E8EBF4;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .gallery-main-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .gallery-placeholder {
    font-family: var(--f-display);
    font-size: 3rem;
    font-weight: 800;
    color: rgba(0,0,0,0.12);
    letter-spacing: 0.05em;
  }

  .product-gallery__thumbs {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .thumb {
    width: 72px;
    height: 72px;
    border-radius: 10px;
    overflow: hidden;
    border: 2px solid transparent;
    background: #E8EBF4;
    padding: 4px;
    transition: border-color 0.2s;
    cursor: pointer;
  }

  .thumb:hover { border-color: var(--border-dark); }
  .thumb--active { border-color: var(--red) !important; }
  .thumb img { width: 100%; height: 100%; object-fit: contain; border-radius: 6px; }

  /* ── Infos ── */
  .product-info__breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .product-info__breadcrumb a:hover { color: var(--text-primary); }

  .product-info__title {
    font-family: var(--f-display);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .product-info__price {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .price-current {
    font-family: var(--f-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .price-current--sale { color: var(--red); }

  .price-compare {
    font-size: 1rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .product-info__description {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Variants */
  .product-info__variants { margin-bottom: 1.5rem; }

  .variant-group { margin-bottom: 1rem; }

  .variant-group__label {
    font-family: var(--f-display);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  .variant-group__options { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .variant-option {
    padding: 0.4rem 1rem;
    border-radius: 8px;
    border: 1.5px solid var(--border);
    font-family: var(--f-display);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: all 0.2s;
  }
  .variant-option:hover { border-color: var(--red); color: var(--red); }
  .variant-option--active { background: var(--red); border-color: var(--red); color: #fff; }

  /* Stock */
  .product-info__stock { margin-bottom: 1.5rem; }
  .stock-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: var(--f-display);
  }
  .stock-badge--in { color: #16a34a; }
  .stock-badge--out { color: var(--red); }

  /* Add to cart */
  .btn-add-cart {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    background: var(--red);
    color: #fff;
    font-family: var(--f-display);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 1rem;
    border-radius: var(--radius);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background 0.2s, transform 0.15s;
    margin-bottom: 1.5rem;
    cursor: pointer;
    border: none;
  }
  .btn-add-cart:hover { background: var(--red-dark); transform: translateY(-1px); }
  .btn-add-cart:disabled {
    background: var(--border);
    color: var(--text-muted);
    cursor: not-allowed;
    transform: none;
  }

  /* Garanties */
  .product-guarantees {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    background: #F8F8F8;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .guarantee-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }
  .guarantee-item svg { color: var(--accent-secondary); flex-shrink: 0; }

  /* Related */
  .related-products { padding-top: 3rem; border-top: 1px solid var(--border); }
  .related-products__title {
    font-family: var(--f-display);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .product-page { padding: 1rem 1rem 3rem; }
    .product-page__inner { grid-template-columns: 1fr; gap: 2rem; }
    .product-info__title { font-size: 1.4rem; }
    .price-current { font-size: 1.4rem; }
    .product-gallery__thumbs { gap: 0.5rem; }
    .thumb { width: 60px; height: 60px; }
  }
{% endstylesheet %}

<script>
  function pvSwitchImage(url, btn) {
    const mainImg = document.querySelector('.gallery-main-img');
    if (mainImg) {
      mainImg.style.opacity = '0.7';
      mainImg.src = url;
      mainImg.onload = () => { mainImg.style.opacity = '1'; };
    }
    document.querySelectorAll('.thumb').forEach(t => t.classList.remove('thumb--active'));
    if (btn) btn.classList.add('thumb--active');
  }

  function pvSelectVariant(option, value, btn) {
    document.querySelectorAll(`[onclick*="${option}"]`).forEach(b => b.classList.remove('variant-option--active'));
    btn.classList.add('variant-option--active');
    // TODO: update variant ID via Shopify variants JS
  }
</script>

{% schema %}
{
  "name": "Page produit",
  "settings": [],
  "presets": [{ "name": "Page produit" }]
}
{% endschema %}
