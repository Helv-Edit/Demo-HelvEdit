{% doc %}
  Renders a collection page with hero, product grid, and basic layout.
{% enddoc %}

<div class="collection-page">
  <section class="collection-hero">
    <div class="collection-hero__content">
      <h1 class="collection-hero__title">{{ collection.title }}</h1>
      {% if collection.description %}
        <p class="collection-hero__description">{{ collection.description }}</p>
      {% endif %}
    </div>
  </section>

  <div class="collection-container">
    <main class="collection-main">
      {% if collection.products_count > 0 %}
        <div class="products-grid">
          {% for product in collection.products %}
            <article class="product-card">
              <a href="{{ product.url }}" class="product-card__link">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}" loading="lazy" />
                {% endif %}
              </a>

              <div class="product-card__content">
                <h3 class="product-card__title">{{ product.title }}</h3>
                <div class="product-card__price">{{ product.price | money }}</div>
                <form method="post" action="/cart/add">
                  <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                  <button type="submit" class="btn btn--primary btn--sm">Add to Cart</button>
                </form>
              </div>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="collection-empty">
          <p>No products in this collection</p>
        </div>
      {% endif %}
    </main>
  </div>
</div>

{% stylesheet %}
  .collection-page {
    min-height: 100vh;
  }

  .collection-hero {
    background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%);
    padding: 3rem 2rem;
    text-align: center;
    margin-bottom: 3rem;
  }

  .collection-hero__title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .collection-hero__description {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .collection-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2rem;
  }

  .product-card {
    background: var(--bg-secondary);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }

  .product-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent-secondary);
  }

  .product-card__link {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .product-card__link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__link img {
    transform: scale(1.05);
  }

  .product-card__content {
    padding: 1.5rem;
  }

  .product-card__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .product-card__price {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent-warm);
    margin-bottom: 1rem;
  }

  .product-card .btn {
    width: 100%;
  }

  .collection-empty {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .collection-hero {
      padding: 2rem 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
