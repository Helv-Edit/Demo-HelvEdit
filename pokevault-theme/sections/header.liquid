{% doc %}
  Header sticky — logo holo centré, icônes droite, dark theme PokeVault.
{% enddoc %}

<header class="site-header">

  <!-- Logo centré -->
  <a href="{{ routes.root_url }}" class="logo">POKE<b>VAULT</b></a>

  <!-- Actions droite -->
  <div class="header-actions">

    <!-- Langue -->
    {% if localization.available_locales.size > 1 %}
      <div class="lang-switcher">
        {% form 'localization' %}
          {% for locale in localization.available_locales %}
            <button type="submit" name="locale_code" value="{{ locale.iso_code }}"
              class="lang-btn{% if locale.iso_code == localization.current_locale.iso_code %} active{% endif %}">
              {{ locale.iso_code | upcase }}
            </button>
            {%- unless forloop.last %}<span class="lang-sep">|</span>{% endunless %}
          {% endfor %}
        {% endform %}
      </div>
    {% endif %}

    <!-- Compte -->
    {% if customer %}
      <a href="{{ routes.account_url }}" class="icon-btn" aria-label="{{ customer.first_name }}">
    {% else %}
      <a href="{{ routes.account_login_url }}" class="icon-btn" aria-label="{{ 'header.login' | t }}">
    {% endif %}
      <svg fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
    </a>

    <!-- Panier -->
    <button class="icon-btn" id="cart-toggle" aria-label="{{ 'header.cart' | t }}">
      <svg fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
      </svg>
      <span class="cart-badge" id="cart-badge">0</span>
    </button>

    <!-- Burger mobile -->
    <button class="burger" id="burger-btn" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>

  </div>
</header>

<!-- Mobile nav -->
<nav class="mobile-nav" id="mobile-nav">
  <a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a>
  <a href="/collections/acrylique">{{ 'header.acrylic' | t }}</a>
  <a href="/collections/sleeves">{{ 'header.sleeves' | t }}</a>
  <a href="/collections/toploaders">{{ 'header.toploaders' | t }}</a>
</nav>

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": []
}
{% endschema %}
