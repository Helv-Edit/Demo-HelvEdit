{% doc %}
  Renders the site header with logo, navigation, and action buttons (account, cart).
  Header is sticky and includes responsive mobile navigation.
{% enddoc %}

<header class="site-header">
  <!-- Logo -->
  <a href="{{ routes.root_url }}" class="site-logo">
    <span>PokeVault</span>
  </a>

  <!-- Navigation -->
  <nav class="site-nav">
    <a href="{{ routes.root_url }}" class="nav-link">{{ 'header.home' | t }}</a>
    <a href="/collections/acrylique" class="nav-link">{{ 'header.acrylic' | t }}</a>
    <a href="/collections/sleeves" class="nav-link">{{ 'header.sleeves' | t }}</a>
    <a href="/collections/toploaders" class="nav-link">{{ 'header.toploaders' | t }}</a>
  </nav>

  <!-- Action Buttons (Language + Account + Cart) -->
  <div class="header-actions">
    <!-- Language Selector -->
    <div class="language-selector">
      {% form 'localization' %}
        <div class="lang-form">
          <select id="localization-form-selector" name="locale_code" class="lang-select">
            {% for locale in localization.available_locales %}
              <option value="{{ locale.iso_code }}" {% if locale.iso_code == localization.current_locale.iso_code %}selected{% endif %}>
                {{ locale.endonym_name | capitalize }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endform %}
    </div>

    {% if customer %}
      <a href="{{ routes.account_url }}" class="header-btn">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z"/>
        </svg>
        {{ customer.first_name }}
      </a>
    {% else %}
      <a href="/account/login" class="header-btn">{{ 'header.login' | t }}</a>
    {% endif %}

    <button class="header-btn" id="cart-toggle" aria-label="{{ 'header.cart' | t }}">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="9" cy="21" r="1"/>
        <circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
      </svg>
      <span id="cart-count" class="cart-count" style="display: none;">0</span>
    </button>
  </div>
</header>

{% stylesheet %}
  /* Header extends global styles from pokevault.css */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-logo {
    font-family: var(--f-manga);
    font-size: 1.5rem;
    color: var(--text-primary);
    white-space: nowrap;
    min-width: fit-content;
    display: flex;
    align-items: center;
  }

  .site-logo:hover {
    color: var(--yellow);
  }

  .site-logo span {
    color: var(--yellow);
  }

  .site-nav {
    display: flex;
    gap: 2.5rem;
    flex: 1;
    justify-content: center;
    margin: 0 2rem;
  }

  .nav-link {
    font-family: var(--f-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--yellow);
    border-bottom-color: var(--yellow);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .language-selector {
    display: flex;
    align-items: center;
  }

  .lang-form {
    display: flex;
    align-items: center;
  }

  .lang-select {
    font-family: var(--f-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    background-color: transparent;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.5rem;
    transition: color 0.3s ease;
  }

  .lang-select:hover {
    color: var(--accent-primary);
  }

  .header-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    position: relative;
    text-decoration: none;
  }

  .header-btn:hover {
    background-color: var(--bg-secondary);
    color: var(--yellow);
  }

  .header-btn svg {
    width: 18px;
    height: 18px;
  }

  .cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background-color: var(--yellow);
    color: var(--bg-primary);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 0.7rem;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .site-nav {
      display: none;
    }

    .site-logo {
      font-size: 1.25rem;
    }

    .header-actions {
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const localizationForm = document.querySelector('form[action*="localization"]');
    const localizationSelect = document.getElementById('localization-form-selector');

    if (localizationSelect) {
      localizationSelect.addEventListener('change', function() {
        if (localizationForm) {
          localizationForm.submit();
        }
      });
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": []
}
{% endschema %}
