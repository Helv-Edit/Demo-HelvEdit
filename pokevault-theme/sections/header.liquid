{% doc %}
  Header sticky — logo, navigation, sélecteur de langue, compte, panier.
{% enddoc %}

<header class="site-header">

  <!-- Logo -->
  <a href="{{ routes.root_url }}" class="site-logo">
    Poke<span>Vault</span>
  </a>

  <!-- Spacer central -->
  <div class="site-nav-spacer"></div>

  <!-- Actions droite -->
  <div class="header-actions">

    <!-- Sélecteur de langue -->
    {% if localization.available_locales.size > 1 %}
      <div class="lang-switcher">
        {% form 'localization' %}
          {% for locale in localization.available_locales %}
            <button
              type="submit"
              name="locale_code"
              value="{{ locale.iso_code }}"
              class="lang-btn{% if locale.iso_code == localization.current_locale.iso_code %} lang-btn--active{% endif %}"
              aria-label="{{ locale.endonym_name }}"
            >
              {{ locale.iso_code | upcase }}
            </button>
            {%- unless forloop.last %}<span class="lang-sep">|</span>{% endunless %}
          {% endfor %}
        {% endform %}
      </div>
    {% endif %}

    <!-- Compte -->
    {% if customer %}
      <a href="{{ routes.account_url }}" class="header-icon-btn" aria-label="{{ customer.first_name }}">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>
    {% else %}
      <a href="/account/login" class="header-icon-btn" aria-label="{{ 'header.login' | t }}">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
          <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>
    {% endif %}

    <!-- Panier -->
    <button class="header-icon-btn header-cart-btn" id="cart-toggle" aria-label="{{ 'header.cart' | t }}">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
        <circle cx="9" cy="21" r="1"/>
        <circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
      </svg>
      <span id="cart-count" class="cart-count" style="display:none">0</span>
    </button>

  </div>
</header>

{% stylesheet %}
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* ── Logo ── */
  .site-logo {
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    letter-spacing: -0.02em;
    transition: opacity 0.2s;
  }

  .site-logo:hover { opacity: 0.75; }

  .site-logo span { color: var(--red); }

  /* ── Spacer ── */
  .site-nav-spacer { flex: 1; }

  /* ── Actions ── */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* ── Langue ── */
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    margin-right: 0.5rem;
  }

  .lang-switcher form {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .lang-btn {
    font-family: var(--f-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #999;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.2rem 0.3rem;
    transition: color 0.2s;
    line-height: 1;
  }

  .lang-btn:hover { color: var(--text-primary); }

  .lang-btn--active {
    color: var(--text-primary);
    cursor: default;
  }

  .lang-sep {
    font-size: 0.65rem;
    color: #ccc;
    user-select: none;
    line-height: 1;
  }

  /* ── Icônes ── */
  .header-icon-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    color: #444;
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.18s, color 0.18s;
    position: relative;
  }

  .header-icon-btn:hover {
    background: #F2F2F2;
    color: var(--text-primary);
  }

  /* Badge panier */
  .cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    background: var(--red);
    color: #fff;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 0.6rem;
    min-width: 16px;
    height: 16px;
    border-radius: 8px;
    padding: 0 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .site-nav { display: none; }
    .site-logo { font-size: 1.1rem; }
    .header-actions { gap: 0.25rem; }
    .lang-switcher { margin-right: 0.25rem; }
  }
{% endstylesheet %}

{% javascript %}
  /* Pas de JS nécessaire — les boutons lang-btn soumettent le form nativement */
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": []
}
{% endschema %}
