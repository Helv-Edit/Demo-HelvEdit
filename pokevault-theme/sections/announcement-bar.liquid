{% doc %}
  Renders a rotating announcement banner with 3 messages cycling every 5 seconds.
{% enddoc %}

<div class="announcement-bar">
  <div class="announcement-content">
    <div class="announcement-item active" data-index="0">
      {{ 'announcement.delivery_france' | t }}
    </div>
    <div class="announcement-item" data-index="1">
      {{ 'announcement.authentic' | t }}
    </div>
    <div class="announcement-item" data-index="2">
      {{ 'announcement.slot_3' | t }}
    </div>
  </div>

  <div class="announcement-dots">
    <span class="dot active" data-index="0"></span>
    <span class="dot" data-index="1"></span>
    <span class="dot" data-index="2"></span>
  </div>
</div>

{% stylesheet %}
  .announcement-bar {
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 2rem;
    text-align: center;
    position: relative;
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .announcement-content {
    position: relative;
    min-height: 20px;
    flex: 1;
  }

  .announcement-item {
    font-family: var(--f-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: absolute;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
    width: 100%;
  }

  .announcement-item.active {
    position: relative;
    opacity: 1;
  }

  .announcement-dots {
    position: absolute;
    bottom: 8px;
    right: 2rem;
    display: flex;
    gap: 0.5rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--border);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .dot.active {
    background-color: var(--yellow);
  }

  @media (max-width: 768px) {
    .announcement-bar {
      padding: 0.5rem 1rem;
    }

    .announcement-item {
      font-size: 0.8rem;
    }

    .announcement-dots {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const items = document.querySelectorAll('.announcement-item');
    const dots = document.querySelectorAll('.announcement-dots .dot');
    let currentIndex = 0;

    function showItem(index) {
      items.forEach(item => item.classList.remove('active'));
      dots.forEach(dot => dot.classList.remove('active'));

      items[index].classList.add('active');
      dots[index].classList.add('active');
    }

    function nextItem() {
      currentIndex = (currentIndex + 1) % items.length;
      showItem(currentIndex);
    }

    // Rotate every 5 seconds
    setInterval(nextItem, 5000);

    // Click dots to manually switch
    dots.forEach((dot, index) => {
      dot.addEventListener('click', function() {
        currentIndex = index;
        showItem(currentIndex);
      });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "settings": []
}
{% endschema %}
