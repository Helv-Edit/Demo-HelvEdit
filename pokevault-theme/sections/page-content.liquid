{% doc %}
  Section générique pour les pages statiques (à-propos, livraison, contact, faq).
{% enddoc %}

<div class="page-content-wrapper">
  <div class="page-content-inner">

    <div class="page-content__header">
      <h1 class="page-content__title">{{ page.title }}</h1>
    </div>

    {% if page.content != blank %}
      <div class="page-content__body rte">
        {{ page.content }}
      </div>
    {% endif %}

    {% if page.handle == 'contact' %}
      <div class="contact-form-wrapper">
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div class="form-success">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/>
              </svg>
              {{ 'contact.success' | t | default: 'Message envoyé ! Nous vous répondrons rapidement.' }}
            </div>
          {% endif %}

          <div class="form-row">
            <div class="form-group">
              <label for="contact-name">{{ 'contact.name' | t | default: 'Nom' }}</label>
              <input type="text" id="contact-name" name="contact[name]" required>
            </div>
            <div class="form-group">
              <label for="contact-email">{{ 'contact.email' | t | default: 'Email' }}</label>
              <input type="email" id="contact-email" name="contact[email]" required>
            </div>
          </div>

          <div class="form-group">
            <label for="contact-subject">{{ 'contact.subject' | t | default: 'Sujet' }}</label>
            <input type="text" id="contact-subject" name="contact[subject]">
          </div>

          <div class="form-group">
            <label for="contact-message">{{ 'contact.message' | t | default: 'Message' }}</label>
            <textarea id="contact-message" name="contact[body]" rows="6" required></textarea>
          </div>

          <button type="submit" class="btn-submit">
            {{ 'contact.send' | t | default: 'Envoyer le message' }}
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        {% endform %}
      </div>
    {% endif %}

    {% if page.handle == 'faq' %}
      <div class="faq-wrapper">
        {% assign faq_items = page.content | split: '<h3>' %}
        {% for item in faq_items %}
          {% if item != blank %}
            {% assign parts = item | split: '</h3>' %}
            {% if parts.size > 1 %}
              <details class="faq-item">
                <summary class="faq-question">
                  {{ parts[0] }}
                  <svg class="faq-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </summary>
                <div class="faq-answer">{{ parts[1] }}</div>
              </details>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>

{% stylesheet %}
  .page-content-wrapper {
    max-width: 820px;
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
  }

  .page-content__header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-content__title {
    font-family: var(--f-display);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .page-content__body {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .rte h2 {
    font-family: var(--f-display);
    font-size: 1.2rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem;
    color: var(--text-primary);
  }
  .rte p { margin-bottom: 1rem; }
  .rte ul, .rte ol { padding-left: 1.5rem; margin-bottom: 1rem; }
  .rte li { margin-bottom: 0.4rem; }
  .rte a { color: var(--red); text-decoration: underline; }
  .rte strong { font-weight: 700; color: var(--text-primary); }

  /* Contact form */
  .contact-form-wrapper {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .form-success {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-radius: var(--radius);
    color: #166534;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .form-group label {
    font-family: var(--f-display);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--f-body);
    font-size: 0.9rem;
    color: var(--text-primary);
    background: #fff;
    transition: border-color 0.2s;
    resize: vertical;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-secondary);
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--red);
    color: #fff;
    font-family: var(--f-display);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background 0.2s;
    border: none;
    cursor: pointer;
  }
  .btn-submit:hover { background: var(--red-dark); }

  /* FAQ */
  .faq-wrapper { margin-top: 2rem; }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-family: var(--f-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    transition: color 0.2s;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question:hover { color: var(--red); }

  .faq-icon { flex-shrink: 0; transition: transform 0.25s ease; }
  details[open] .faq-icon { transform: rotate(180deg); }

  .faq-answer {
    padding: 0 0 1.25rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .page-content-wrapper { padding: 2rem 1rem 3rem; }
    .form-row { grid-template-columns: 1fr; }
    .page-content__title { font-size: 1.5rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page contenu",
  "settings": [],
  "presets": [{ "name": "Page contenu" }]
}
{% endschema %}
