{% doc %}
  Footer dark theme PokeVault — logo holo, liens, réseaux, mentions légales.
{% enddoc %}

<footer class="site-footer">
  <div class="footer-grid">

    <div>
      <span class="footer-logo">POKE<b>VAULT</b></span>
      <p class="footer-tagline">{{ 'footer.tagline' | t }}</p>
      <div class="footer-social">
        <a href="#" class="social-btn">IG</a>
        <a href="#" class="social-btn">TK</a>
        <a href="#" class="social-btn">FB</a>
        <a href="#" class="social-btn">YT</a>
      </div>
    </div>

    <div class="footer-col">
      <h4>{{ 'footer.products' | t }}</h4>
      <ul>
        <li><a href="/collections/acrylique">{{ 'header.acrylic' | t }}</a></li>
        <li><a href="/collections/sleeves">{{ 'header.sleeves' | t }}</a></li>
        <li><a href="/collections/toploaders">{{ 'header.toploaders' | t }}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>{{ 'footer.info' | t }}</h4>
      <ul>
        <li><a href="/pages/a-propos">{{ 'footer.about_page' | t }}</a></li>
        <li><a href="/pages/livraison">{{ 'footer.shipping' | t }}</a></li>
        <li><a href="/pages/contact">{{ 'footer.contact' | t }}</a></li>
        <li><a href="/pages/faq">{{ 'footer.faq' | t }}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>{{ 'footer.legal' | t }}</h4>
      <ul>
        <li><a href="/pages/confidentialite">{{ 'footer.privacy' | t }}</a></li>
        <li><a href="/pages/cgv">{{ 'footer.terms' | t }}</a></li>
        <li><a href="/pages/retours">{{ 'footer.returns' | t }}</a></li>
        <li><a href="/pages/mentions-legales">{{ 'footer.mentions' | t }}</a></li>
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <p>© {{ 'now' | date: '%Y' }} PokeVault — {{ 'footer.by' | t }} <strong>Helv'Edit</strong></p>
    <div class="payment-icons">
      <span class="pay-icon">VISA</span>
      <span class="pay-icon">MC</span>
      <span class="pay-icon">AMEX</span>
      <span class="pay-icon">PAYPAL</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": []
}
{% endschema %}
