<section class="hero">
  <!-- Floating irezumi clouds background -->
  <div id="irezumiClouds"></div>

  <div class="hero__inner">
    <div class="hero__badge">✦ La boutique collector</div>

    <h1 class="hero__title">
      {{ section.settings.title | default: 'La boutique des' }}<br>
      <span>{{ section.settings.title_accent | default: 'vrais dresseurs' }}</span>
    </h1>

    <p class="hero__sub">
      {{ section.settings.subtitle | default: "Boosters, sleeves et protections premium — tout ce qu'il faut pour collectionner comme un pro." }}
    </p>

    <div class="hero__ctas">
      <a href="#catalog" class="btn-primary-hero" onclick="document.getElementById('catalog').scrollIntoView({behavior:'smooth'});return false;">
        Voir les produits →
      </a>
      {% if customer %}
        <a href="{{ routes.account_url }}" class="btn-ghost-hero">Mon compte</a>
      {% else %}
        <a href="{{ routes.account_register_url }}" class="btn-ghost-hero">Créer un compte</a>
      {% endif %}
    </div>

    <div class="hero__stats">
      <div class="hero__stat">
        <span class="hero__stat-num" data-count="500" data-suffix="+">500+</span>
        <span class="hero__stat-label">Références</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-num">3</span>
        <span class="hero__stat-label">Langues FR·JP·EN</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-num" data-count="48" data-suffix="H">48H</span>
        <span class="hero__stat-label">Livraison France</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre ligne 1", "default": "La boutique des" },
    { "type": "text", "id": "title_accent", "label": "Titre ligne 2", "default": "vrais dresseurs" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
