{% doc %}
  Hero section — full-width photo with centered title only. CasePlex style.
{% enddoc %}

<section class="hero">
  <div class="hero__bg">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 2000 | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero__bg-img',
          alt: section.settings.title }}
    {% else %}
      <div class="hero__bg-fallback"></div>
    {% endif %}
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content">
    <h1 class="hero__title">
      {%- if section.settings.title != blank -%}
        {{ section.settings.title }}
      {%- else -%}
        {{ 'hero.title' | t }}
      {%- endif -%}
      {% if section.settings.title_accent != blank %}
        <span class="hero__accent">{{ section.settings.title_accent }}</span>
      {% endif %}
    </h1>
    {% if section.settings.subtitle != blank %}
      <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    width: 100%;
    height: 72vh;
    min-height: 420px;
    max-height: 720px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__bg-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a0825 0%, #2d1045 25%, #1a1040 50%, #0d1a40 75%, #1a1560 100%);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.15) 0%,
      rgba(0,0,0,0.35) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 3.5rem 2rem 0;
  }

  .hero__title {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-shadow: 0 2px 24px rgba(0,0,0,0.25);
    margin: 0;
  }

  .hero__accent {
    display: block;
    color: var(--yellow);
  }

  .hero__subtitle {
    margin-top: 1rem;
    font-size: 1rem;
    color: rgba(255,255,255,0.85);
    font-weight: 400;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .hero {
      height: 55vh;
      min-height: 300px;
      margin-bottom: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image de fond"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.hero.title",
      "default": "Protections Acryliques"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "t:sections.hero.title_accent"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:sections.hero.subtitle"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
