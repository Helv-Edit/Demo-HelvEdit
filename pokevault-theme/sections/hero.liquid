<section class="hero">
  <div class="hero__inner">

    <div class="hero__badge">
      ✦ {{ section.settings.badge_text | default: 'La boutique collector' }}
    </div>

    <h1 class="hero__title">
      {{ section.settings.title | default: 'La boutique des' }}<br>
      <span>{{ section.settings.title_accent | default: 'vrais dresseurs' }}</span>
    </h1>

    <p class="hero__sub">
      {{ section.settings.subtitle | default: "Boosters, sleeves et protections premium — tout ce qu'il faut pour collectionner comme un pro." }}
    </p>

    <div class="hero__ctas">
      <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn-manga btn-manga--primary">
        {{ section.settings.cta_text | default: 'Voir les produits' }} →
      </a>
      {% if customer %}
        <a href="{{ routes.account_url }}" class="btn-manga btn-manga--ghost">Mon compte</a>
      {% else %}
        <a href="{{ routes.account_register_url }}" class="btn-manga btn-manga--ghost">Créer un compte</a>
      {% endif %}
    </div>

    <div class="hero__stats">
      <div class="hero__stat">
        <span class="hero__stat-num">500+</span>
        <span class="hero__stat-label">Références</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-num">3</span>
        <span class="hero__stat-label">Langues FR·JP·EN</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-num">48H</span>
        <span class="hero__stat-label">Livraison France</span>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "La boutique collector" },
    { "type": "text", "id": "title", "label": "Titre ligne 1", "default": "La boutique des" },
    { "type": "text", "id": "title_accent", "label": "Titre ligne 2", "default": "vrais dresseurs" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre" },
    { "type": "text", "id": "cta_text", "label": "Bouton texte", "default": "Voir les produits" },
    { "type": "url", "id": "cta_url", "label": "Bouton lien" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
