{% doc %}
  Hero section 3D — coque acrylique GLB tournante, stats, CTA.
{% enddoc %}

<section class="section-3d" id="hero-3d">
  <div class="section-3d__inner">

    <div class="section-3d__text">
      <div class="section-3d__label">{{ section.settings.label | default: 'Notre Bestseller' }}</div>

      <h1 class="section-3d__title">
        {{ section.settings.title | default: 'Protection Acrylique' }}<br>
        <span>{{ section.settings.title_accent | default: 'ETB' }}</span>
      </h1>

      <p class="section-3d__desc">
        {{ section.settings.description | default: "La protection plébiscitée par +200 collectionneurs. Acrylique cristal 4mm, fermeture magnétique à 6 aimants, protection UV 99%." }}
      </p>

      <div class="section-3d__stats">
        <div class="stat-item-3d">
          <div class="stat-num">{{ section.settings.stat1_value | default: '4.9' }}<span>★</span></div>
          <div class="stat-lbl">{{ section.settings.stat1_label | default: 'Note moyenne' }}</div>
        </div>
        <div class="stat-item-3d">
          <div class="stat-num">{{ section.settings.stat2_value | default: '214' }}</div>
          <div class="stat-lbl">{{ section.settings.stat2_label | default: 'Avis vérifiés' }}</div>
        </div>
        <div class="stat-item-3d">
          <div class="stat-num">{{ section.settings.stat3_value | default: '+31' }}</div>
          <div class="stat-lbl">{{ section.settings.stat3_label | default: 'Acheteurs / semaine' }}</div>
        </div>
      </div>

      {% if section.settings.cta_product != blank %}
        <a href="{{ section.settings.cta_product.url }}" class="btn-3d-cta">
          {{ section.settings.cta_label | default: 'Voir le produit' }}
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {% else %}
        <a href="/collections/acrylique" class="btn-3d-cta">
          {{ section.settings.cta_label | default: 'Voir le produit' }}
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {% endif %}
    </div>

    <div class="section-3d__canvas-col">
      <div class="section-3d__canvas-wrap">
        <canvas id="canvas-3d"></canvas>
      </div>
      <div class="canvas-hint">⟳ Glissez pour faire tourner</div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero 3D",
  "settings": [
    { "type": "text", "id": "label", "label": "Label eyebrow", "default": "Notre Bestseller" },
    { "type": "text", "id": "title", "label": "Titre ligne 1", "default": "Protection Acrylique" },
    { "type": "text", "id": "title_accent", "label": "Titre accent (couleur)", "default": "ETB" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "stat1_value", "label": "Stat 1 — valeur", "default": "4.9" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 — label", "default": "Note moyenne" },
    { "type": "text", "id": "stat2_value", "label": "Stat 2 — valeur", "default": "214" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 — label", "default": "Avis vérifiés" },
    { "type": "text", "id": "stat3_value", "label": "Stat 3 — valeur", "default": "+31" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 — label", "default": "Acheteurs / semaine" },
    { "type": "product", "id": "cta_product", "label": "Produit mis en avant" },
    { "type": "text", "id": "cta_label", "label": "Texte CTA", "default": "Voir le produit" }
  ],
  "presets": [{ "name": "Hero 3D" }]
}
{% endschema %}
