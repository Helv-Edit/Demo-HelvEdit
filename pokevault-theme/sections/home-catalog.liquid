<section id="catalog" class="catalog-wrapper">

  <!-- Filter tabs — sticky, client-side, no page reload -->
  <div class="filter-tabs">
    <button class="filter-tab active" data-cat="all">Tout</button>
    <button class="filter-tab" data-cat="booster">Boosters</button>
    <button class="filter-tab" data-cat="sleeve">Sleeves</button>
    <button class="filter-tab" data-cat="protection">Protections</button>
    <button class="filter-tab" data-cat="toploader">Toploaders</button>
  </div>

  <!-- Section header -->
  <div class="catalog-header" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
    <span class="catalog-title">Tous les produits</span>
    <span id="catalogCount" style="font-size:0.7rem;color:var(--text-muted);font-weight:600;">
      {{ collections.all.products_count }} produits
    </span>
  </div>

  <!-- Product grid — all products rendered, JS filters in place -->
  <div class="products-grid" id="productGrid" style="position:relative;">
    {% paginate collections.all.products by 60 %}
      {% for product in collections.all.products %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% endpaginate %}
  </div>

</section>

{% schema %}
{
  "name": "Catalogue SPA",
  "settings": [],
  "presets": [{ "name": "Catalogue SPA" }]
}
{% endschema %}
