{% doc %}
  Custom login form for customer accounts.
{% enddoc %}

<section class="login-section">
  <div class="login-container">
    <div class="login-form-wrapper">
      <h2 class="login-form__title">{{ 'customer.login.form_title' | t }}</h2>

      {% form 'customer_login' %}
        {% if form.errors %}
          <div class="form-error">
            <ul>
              {% for field in form.errors %}
                <li>{{ form.errors.messages[field] }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <div class="form-group">
          <label for="CustomerEmail" class="form-label">{{ 'customer.login.email' | t }}</label>
          <input type="email" name="customer[email]" id="CustomerEmail" class="form-input" autocomplete="email" required />
        </div>

        <div class="form-group">
          <label for="CustomerPassword" class="form-label">{{ 'customer.login.password' | t }}</label>
          <input type="password" name="customer[password]" id="CustomerPassword" class="form-input" autocomplete="current-password" required />
        </div>

        <div class="form-group">
          <button type="submit" class="btn btn--primary btn--lg form-submit">
            {{ 'customer.login.submit' | t }}
          </button>
        </div>

        <p class="form-text">
          {{ 'customer.login.no_account' | t }}
          <a href="{{ routes.account_register_url }}" class="form-link">{{ 'customer.login.register' | t }}</a>
        </p>

        <p class="form-text">
          <a href="{{ routes.account_recover_url }}" class="form-link">{{ 'customer.login.forgot_password' | t }}</a>
        </p>
      {% endform %}
    </div>
  </div>
</section>

{% stylesheet %}
  .login-section {
    padding: 4rem 2rem;
    min-height: 60vh;
  }

  .login-container {
    max-width: 500px;
    margin: 0 auto;
  }

  .login-form-wrapper {
    background-color: var(--bg-secondary);
    padding: 3rem;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .login-form__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2rem;
    text-align: center;
  }

  .form-error {
    background-color: rgba(161, 26, 28, 0.1);
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius);
    padding: 1rem;
    margin-bottom: 1.5rem;
    color: var(--accent-primary);
    font-size: 0.9rem;
  }

  .form-error ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .form-error li {
    margin-bottom: 0.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-label {
    display: block;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--f-body);
    font-size: 1rem;
    transition: all 0.2s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--accent-secondary);
    box-shadow: 0 0 0 3px rgba(153, 188, 195, 0.1);
  }

  .form-submit {
    width: 100%;
  }

  .form-text {
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: 1.5rem;
  }

  .form-link {
    color: var(--accent-primary);
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .form-link:hover {
    color: var(--yellow);
  }

  @media (max-width: 768px) {
    .login-section {
      padding: 2rem 1rem;
    }

    .login-form-wrapper {
      padding: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Login Form",
  "settings": []
}
{% endschema %}
