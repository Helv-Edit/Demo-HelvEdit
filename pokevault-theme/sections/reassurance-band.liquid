{% doc %}
  Bande de réassurance 4 items — dark theme PokeVault.
{% enddoc %}

<section class="reassurance-band">
  <div class="reassurance-grid">

    <div class="reassurance-item">
      <div class="reassurance-icon">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v3h-7V8z"/>
          <circle cx="5.5" cy="18.5" r="1.5"/><circle cx="18.5" cy="18.5" r="1.5"/>
        </svg>
      </div>
      <h3>{{ 'reassurance.delivery_title' | t }}</h3>
      <p>{{ 'reassurance.delivery_desc' | t }}</p>
    </div>

    <div class="reassurance-item">
      <div class="reassurance-icon">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>
        </svg>
      </div>
      <h3>{{ 'reassurance.uv_title' | t }}</h3>
      <p>{{ 'reassurance.uv_desc' | t }}</p>
    </div>

    <div class="reassurance-item">
      <div class="reassurance-icon">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
        </svg>
      </div>
      <h3>{{ 'reassurance.custom_title' | t }}</h3>
      <p>{{ 'reassurance.custom_desc' | t }}</p>
    </div>

    <div class="reassurance-item">
      <div class="reassurance-icon">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
          <circle cx="9" cy="10" r="1"/><circle cx="12" cy="10" r="1"/><circle cx="15" cy="10" r="1"/>
        </svg>
      </div>
      <h3>{{ 'reassurance.support_title' | t }}</h3>
      <p>{{ 'reassurance.support_desc' | t }}</p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "t:sections.reassurance_band.name",
  "settings": [],
  "presets": [{ "name": "Bande réassurance" }]
}
{% endschema %}
