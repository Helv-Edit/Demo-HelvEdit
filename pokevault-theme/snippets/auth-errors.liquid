{%- if form.errors -%}
  <div class="form-errors" role="alert">
    {%- for error in form.errors -%}
      <p class="form-error-message">
        <strong>{{ error | capitalize }}</strong>
        {%- if form.errors.messages[error] %}: {{ form.errors.messages[error] }}{%- endif -%}
      </p>
    {%- endfor -%}
  </div>
{%- endif -%}
