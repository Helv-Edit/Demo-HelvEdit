{%- if show_register -%}
<div class="auth-tabs" role="tablist">
  <button
    class="auth-tabs__item auth-tabs__item--active"
    data-tab="login"
    role="tab"
    aria-selected="true"
    aria-controls="login-panel"
  >
    {{ 'customers.login.tab' | t | default: 'Connexion' }}
  </button>
  <button
    class="auth-tabs__item"
    data-tab="register"
    role="tab"
    aria-selected="false"
    aria-controls="register-panel"
  >
    {{ 'customers.register.tab' | t | default: 'Créer un compte' }}
  </button>
</div>
{%- endif -%}
