{% comment %}
  Sakura background — animated cherry blossom scene (anime/manga style)
  Integrates as a fixed fullscreen background with falling petals
{% endcomment %}

<style>
  :root {
    --sakura-paper: #f5ede0;
    --sakura-paper-2: #e8dccf;
    --sakura-ink: #0c0a09;
    --sakura-ink-soft: #1a1715;
    --sakura-yellow: #FFCB05;
    --sakura-yellow-fade: rgba(255, 203, 5, 0.08);
  }

  /* Sakura scene — fixed fullscreen background */
  .sakura-scene {
    position: fixed;
    inset: 0;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(140% 90% at 30% 10%, #ece2cd 0%, var(--sakura-paper) 50%, var(--sakura-paper-2) 100%);
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }

  /* Grain papier */
  .sakura-grain {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(12, 10, 9, 0.03) 1px, transparent 1.4px),
                      radial-gradient(rgba(12, 10, 9, 0.02) 1px, transparent 1.2px);
    background-size: 3px 3px, 7px 7px;
    background-position: 0 0, 1px 2px;
    mix-blend-mode: multiply;
    opacity: 0.3;
  }

  /* Screentone (trame de points) */
  .sakura-screentone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(12, 10, 9, 0.4) 1.1px, transparent 1.6px);
    background-size: 6px 6px;
    mask: radial-gradient(120% 70% at 50% 110%, #000 0%, transparent 55%);
    -webkit-mask: radial-gradient(120% 70% at 50% 110%, #000 0%, transparent 55%);
    mix-blend-mode: multiply;
    opacity: 0.35;
  }

  .sakura-screentone.top {
    mask: radial-gradient(80% 50% at 85% -10%, #000 0%, transparent 60%);
    -webkit-mask: radial-gradient(80% 50% at 85% -10%, #000 0%, transparent 60%);
    background-image: radial-gradient(rgba(12, 10, 9, 0.3) 1px, transparent 1.4px);
    background-size: 5px 5px;
    opacity: 0.25;
  }

  /* Lignes de vent */
  .sakura-speedlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(-6deg,
      transparent 0 26px,
      rgba(12, 10, 9, 0.03) 26px 27px,
      transparent 27px 70px);
    animation: sakura-drift 18s linear infinite;
    mix-blend-mode: multiply;
    opacity: 0.3;
  }

  @keyframes sakura-drift {
    from { transform: translateX(0); }
    to { transform: translateX(-160px); }
  }

  /* Hachures diagonales */
  .sakura-hatch {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(32deg,
      rgba(12, 10, 9, 0) 0 3px,
      rgba(12, 10, 9, 0.08) 3px 4px,
      rgba(12, 10, 9, 0) 4px 9px);
    mask: linear-gradient(180deg, transparent 0%, transparent 30%, #000 70%, transparent 100%),
          radial-gradient(60% 40% at 10% 90%, #000, transparent 70%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    mix-blend-mode: multiply;
    opacity: 0.2;
  }

  /* Lune */
  .sakura-moon {
    position: absolute;
    top: 9%;
    right: 12%;
    width: min(22vmin, 260px);
    height: min(22vmin, 260px);
    border-radius: 50%;
    background: var(--sakura-paper);
    box-shadow: inset 0 0 0 3px var(--sakura-ink);
    overflow: hidden;
    z-index: 1;
  }

  .sakura-moon::before {
    content: '';
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background-image: radial-gradient(rgba(12, 10, 9, 0.35) 1px, transparent 1.4px);
    background-size: 7px 7px;
    mask: radial-gradient(70% 70% at 35% 35%, transparent 30%, #000 70%);
    -webkit-mask: radial-gradient(70% 70% at 35% 35%, transparent 30%, #000 70%);
    opacity: 0.4;
  }

  /* Nuages */
  .sakura-clouds {
    position: absolute;
    top: 9%;
    right: -10%;
    width: min(80vmin, 940px);
    height: min(22vmin, 260px);
    pointer-events: none;
    z-index: 2;
    overflow: hidden;
  }

  .sakura-clouds svg {
    position: absolute;
    display: block;
  }

  .sakura-cloud-a {
    width: 75%;
    height: 38%;
    top: 24%;
    left: 0;
    animation: sakura-cloud-drift 36s linear infinite;
  }

  .sakura-cloud-b {
    width: 55%;
    height: 28%;
    top: 58%;
    left: -10%;
    animation: sakura-cloud-drift 54s linear infinite;
    animation-delay: -14s;
    opacity: 0.7;
  }

  @keyframes sakura-cloud-drift {
    0% { transform: translateX(-20%); }
    100% { transform: translateX(110%); }
  }

  /* Branche haut-gauche */
  .sakura-branch {
    position: absolute;
    pointer-events: none;
    transform-origin: 0 0;
  }

  .sakura-branch svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .sakura-branch.tl {
    top: 0;
    left: -2%;
    width: 55vmin;
    max-width: 700px;
    animation: sakura-sway 8s ease-in-out infinite alternate;
  }

  .sakura-branch.br {
    bottom: 0;
    right: -2%;
    width: 60vmin;
    max-width: 750px;
    transform-origin: 100% 100%;
    animation: sakura-sway2 11s ease-in-out infinite alternate;
  }

  @media (max-width: 768px) {
    .sakura-branch.tl {
      width: 70vmin;
      max-width: 100%;
      left: -8%;
    }
    .sakura-branch.br {
      width: 75vmin;
      max-width: 100%;
      right: -8%;
    }
  }

  @keyframes sakura-sway {
    from { transform: rotate(-1.2deg); }
    to { transform: rotate(1.4deg); }
  }

  @keyframes sakura-sway2 {
    from { transform: rotate(-1deg); }
    to { transform: rotate(1.6deg); }
  }

  /* Pétales qui tombent */
  .sakura-petals {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .sakura-petal {
    position: absolute;
    top: -6%;
    width: 22px;
    height: 22px;
    animation: sakura-fall linear infinite;
  }

  .sakura-petal svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .sakura-petal.s {
    width: 14px;
    height: 14px;
  }

  .sakura-petal.l {
    width: 30px;
    height: 30px;
  }

  @keyframes sakura-fall {
    0% { transform: translate3d(0, -8vh, 0) rotate(0deg); }
    50% { transform: translate3d(calc(var(--dx, 30vw) * 0.5), 50vh, 0) rotate(220deg); }
    100% { transform: translate3d(var(--dx, 30vw), 110vh, 0) rotate(540deg); }
  }

  /* Kanji watermark */
  .sakura-kanji {
    position: absolute;
    font-family: "Times New Roman", serif;
    font-weight: 900;
    color: var(--sakura-ink);
    opacity: 0.04;
    pointer-events: none;
    user-select: none;
    line-height: 0.9;
  }

  .sakura-kanji.k1 {
    top: 6%;
    left: 5%;
    font-size: clamp(160px, 28vw, 420px);
  }

  .sakura-kanji.k2 {
    bottom: 4%;
    right: 6%;
    font-size: clamp(120px, 18vw, 280px);
  }
</style>

<svg width="0" height="0" style="position: absolute;" aria-hidden="true">
  <defs>
    <!-- Fleur de cerisier -->
    <symbol id="sakura-blossom" viewBox="-50 -50 100 100">
      <g fill="var(--sakura-paper)" stroke="var(--sakura-ink)" stroke-width="3.2" stroke-linejoin="round">
        <g>
          <path d="M0,-6 C -10,-18 -26,-26 -32,-18 C -38,-10 -28,4 -10,8 C -4,10 0,8 0,-6 Z" transform="rotate(0)"/>
          <path d="M0,-6 C -10,-18 -26,-26 -32,-18 C -38,-10 -28,4 -10,8 C -4,10 0,8 0,-6 Z" transform="rotate(72)"/>
          <path d="M0,-6 C -10,-18 -26,-26 -32,-18 C -38,-10 -28,4 -10,8 C -4,10 0,8 0,-6 Z" transform="rotate(144)"/>
          <path d="M0,-6 C -10,-18 -26,-26 -32,-18 C -38,-10 -28,4 -10,8 C -4,10 0,8 0,-6 Z" transform="rotate(216)"/>
          <path d="M0,-6 C -10,-18 -26,-26 -32,-18 C -38,-10 -28,4 -10,8 C -4,10 0,8 0,-6 Z" transform="rotate(288)"/>
        </g>
        <g fill="none" stroke="var(--sakura-ink)" stroke-width="2.4" stroke-linecap="round">
          <path d="M-28,-22 L-22,-14" transform="rotate(0)"/>
          <path d="M-28,-22 L-22,-14" transform="rotate(72)"/>
          <path d="M-28,-22 L-22,-14" transform="rotate(144)"/>
          <path d="M-28,-22 L-22,-14" transform="rotate(216)"/>
          <path d="M-28,-22 L-22,-14" transform="rotate(288)"/>
        </g>
        <circle cx="0" cy="0" r="4.5" fill="var(--sakura-ink)"/>
        <g stroke="var(--sakura-ink)" stroke-width="1.6" stroke-linecap="round" fill="none">
          <line x1="0" y1="0" x2="0" y2="-9"/>
          <line x1="0" y1="0" x2="8" y2="-4"/>
          <line x1="0" y1="0" x2="-8" y2="-4"/>
          <line x1="0" y1="0" x2="6" y2="6"/>
          <line x1="0" y1="0" x2="-6" y2="6"/>
        </g>
        <g fill="var(--sakura-ink)">
          <circle cx="0" cy="-9" r="1.6"/>
          <circle cx="8" cy="-4" r="1.6"/>
          <circle cx="-8" cy="-4" r="1.6"/>
          <circle cx="6" cy="6" r="1.6"/>
          <circle cx="-6" cy="6" r="1.6"/>
        </g>
      </g>
    </symbol>

    <!-- Pétale qui tombe -->
    <symbol id="sakura-petal-shape" viewBox="-12 -14 24 28">
      <g stroke="var(--sakura-ink)" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" fill="var(--sakura-paper)">
        <path d="M 0,-11 C 8,-9 11,-2 7,7 L 3,5 L 1,9 L 0,7 L -1,9 L -3,5 C -11,-2 -8,-9 0,-11 Z"/>
        <path d="M 0,-8 L 0,5" fill="none" stroke-width="1.2" opacity="0.75"/>
      </g>
    </symbol>
  </defs>
</svg>

<div class="sakura-scene">
  <div class="sakura-kanji k1">桜</div>
  <div class="sakura-kanji k2">春</div>

  <div class="sakura-screentone top"></div>
  <div class="sakura-speedlines"></div>

  <div class="sakura-moon"></div>

  <div class="sakura-clouds">
    <svg class="sakura-cloud-a" viewBox="0 0 400 80" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <g fill="var(--sakura-paper)" stroke="var(--sakura-ink)" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round">
        <path d="M 30,46 C 26,32 44,22 64,26 C 70,14 96,12 116,22 C 130,12 158,14 174,26 C 198,18 226,24 240,34 C 264,30 294,38 310,46 C 332,44 356,50 372,52 L 390,54 L 372,58 C 348,58 320,58 296,56 C 268,54 240,58 214,56 C 186,54 158,58 132,56 C 106,54 80,58 56,56 C 38,54 26,52 30,46 Z"/>
        <path d="M 60,48 C 100,46 160,46 210,48 C 260,50 320,48 360,50" fill="none" stroke="var(--sakura-ink)" stroke-width="1.3" opacity="0.55"/>
      </g>
    </svg>
    <svg class="sakura-cloud-b" viewBox="0 0 320 70" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <g fill="var(--sakura-paper)" stroke="var(--sakura-ink)" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round">
        <path d="M 20,40 C 16,28 36,20 54,24 C 64,14 90,16 104,26 C 122,18 150,22 162,32 C 188,28 218,34 232,42 C 256,40 280,46 296,48 L 310,50 L 294,54 C 268,54 240,54 214,52 C 186,50 160,54 132,52 C 104,50 76,54 50,52 C 30,50 18,46 20,40 Z"/>
      </g>
    </svg>
  </div>

  <div class="sakura-branch tl">
    <svg viewBox="0 0 800 520" aria-hidden="true">
      <g fill="var(--sakura-ink)">
        <path d="M -20,30 C 60,40 120,52 170,72 C 210,88 240,108 270,128 C 305,150 330,170 360,184 C 395,200 430,212 470,216 C 510,220 560,218 610,210 L 612,222 C 562,232 510,234 470,230 C 428,226 392,214 356,198 C 326,184 300,164 266,142 C 236,122 206,102 168,86 C 118,68 56,56 -20,46 Z"/>
        <path d="M 110,55 C 130,80 150,120 158,170 L 152,172 C 144,124 124,84 104,60 Z"/>
      </g>
      <g>
        <use href="#sakura-blossom" x="-20" y="0" width="44" height="44"/>
        <use href="#sakura-blossom" x="40" y="20" width="60" height="60"/>
        <use href="#sakura-blossom" x="130" y="50" width="50" height="50"/>
        <use href="#sakura-blossom" x="170" y="100" width="56" height="56"/>
        <use href="#sakura-blossom" x="220" y="130" width="48" height="48"/>
        <use href="#sakura-blossom" x="290" y="130" width="62" height="62"/>
      </g>
    </svg>
  </div>

  <div class="sakura-petals" id="sakura-petals"></div>

  <div class="sakura-screentone"></div>
  <div class="sakura-hatch"></div>
  <div class="sakura-grain"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const layer = document.getElementById('sakura-petals');
    const petalCount = 40;

    for (let i = 0; i < petalCount; i++) {
      const wrap = document.createElement('div');
      const sizeClass = Math.random() < 0.3 ? 's' : (Math.random() < 0.25 ? 'l' : '');
      wrap.className = 'sakura-petal ' + sizeClass;

      const left = Math.random() * 100;
      const dx = (Math.random() * 70 - 35);
      const baseDur = 10 + Math.random() * 14;
      const dur = baseDur;
      const delay = -Math.random() * dur;

      wrap.style.left = left + 'vw';
      wrap.style.setProperty('--dx', dx + 'vw');
      wrap.style.animationDuration = dur + 's';
      wrap.style.animationDelay = delay + 's';
      wrap.style.opacity = (0.85 + Math.random() * 0.15).toFixed(2);

      wrap.innerHTML = '<svg viewBox="-12 -12 24 24"><use href="#sakura-petal-shape"/></svg>';
      layer.appendChild(wrap);
    }
  });
</script>
