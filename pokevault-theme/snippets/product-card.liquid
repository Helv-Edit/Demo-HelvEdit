{% doc %}
  Renders a CasePlex-style product card.
  Light blue-gray background, contain image, pill badges, minimal info.

  @param {product} product - The product to render

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{% liquid
  assign first_variant = product.first_available_variant
  assign is_available  = first_variant.available
  assign is_new  = false
  if product.tags contains 'nouveau'
    assign is_new = true
  endif
  assign is_sale = false
  if product.compare_at_price > product.price
    assign is_sale = true
  endif

  assign title_lower = product.title | downcase
  assign type_lower  = product.type  | downcase
  assign tags_lower  = product.tags  | join: ' ' | downcase

  assign cat = 'acrylic'
  if type_lower contains 'sleeve' or title_lower contains 'sleeve' or tags_lower contains 'sleeve'
    assign cat = 'sleeve'
  elsif type_lower contains 'toploader' or title_lower contains 'toploader' or tags_lower contains 'toploader'
    assign cat = 'toploader'
  endif
%}

<div class="product-card" data-cat="{{ cat }}">

  <a href="{{ product.url }}" class="product-card__link" tabindex="-1">
    <div class="product-card__image-wrap">

      {% comment %} Badges {% endcomment %}
      <div class="product-card__badges">
        {% unless is_available %}
          <span class="pv-badge pv-badge--out">{{ 'product.out_of_stock' | t }}</span>
        {% endunless %}
        {% if is_new and is_available %}
          <span class="pv-badge pv-badge--new">{{ 'product.badge_new' | t }}</span>
        {% endif %}
        {% if is_sale and is_available %}
          <span class="pv-badge pv-badge--sale">{{ 'product.badge_promo' | t }}</span>
        {% endif %}
      </div>

      {% comment %} Image {% endcomment %}
      <div class="product-card__image">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 600 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            loading="lazy"
            width="600"
            height="450"
          >
        {% else %}
          <div class="product-card__placeholder">
            {% case cat %}
              {% when 'sleeve' %}SLV
              {% when 'toploader' %}TOP
              {% else %}ACR
            {% endcase %}
          </div>
        {% endif %}
      </div>
    </div>
  </a>

  {% comment %} Info {% endcomment %}
  <div class="product-card__info">
    <a href="{{ product.url }}" class="product-card__title">{{ product.title }}</a>
    <div class="product-card__price-row">
      {% if is_sale %}
        <span class="price-compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
      <span class="price-main {% if is_sale %}price-main--sale{% endif %}">
        {{ product.price | money }}
      </span>
    </div>
  </div>

</div>
