{% doc %}
  Carte produit dark — dark theme PokeVault avec pokéball animation.

  @param {product} product - The product to render
  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{% liquid
  assign first_variant = product.first_available_variant
  assign is_available  = first_variant != blank and first_variant.available
  assign is_new        = product.tags contains 'nouveau'
  assign is_bestseller = product.tags contains 'bestseller'

  assign title_lower = product.title | downcase
  assign type_lower  = product.type  | downcase
  assign tags_lower  = product.tags  | join: ' ' | downcase

  assign cat = 'acrylic'
  if type_lower contains 'sleeve' or title_lower contains 'sleeve' or tags_lower contains 'sleeve'
    assign cat = 'sleeve'
  elsif type_lower contains 'toploader' or title_lower contains 'toploader' or tags_lower contains 'toploader'
    assign cat = 'toploader'
  endif
%}

<div class="product-card" data-cat="{{ cat }}">

  {% if is_bestseller %}
    <div class="card-badge badge--bestseller">{{ 'product.badge_bestseller' | t }}</div>
  {% elsif is_new %}
    <div class="card-badge badge--new">{{ 'product.badge_new' | t }}</div>
  {% endif %}

  {% if first_variant %}
    <button class="card-quick-add"
      data-variant-id="{{ first_variant.id }}"
      title="{{ 'product.add_to_cart' | t }}"
      {% unless is_available %}disabled{% endunless %}>
      +
    </button>
  {% endif %}

  <a href="{{ product.url }}">
    <div class="card-image-wrap">
      <div class="card-view-overlay"></div>
      <div class="card-image">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 600 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            loading="lazy"
            width="600"
            height="450"
          >
        {% else %}
          <span style="font-family:var(--f-mono);font-size:.9rem;color:var(--muted)">
            {% case cat %}{% when 'sleeve' %}SLV{% when 'toploader' %}TOP{% else %}ACR{% endcase %}
          </span>
        {% endif %}
      </div>
    </div>
  </a>

  <div class="card-info">
    <a href="{{ product.url }}" class="card-title">{{ product.title }}</a>

    <div class="card-price-row">
      <span class="card-price">{{ product.price | money }}</span>
      <span class="card-stock {% if is_available %}card-stock--in{% else %}card-stock--low{% endif %}">
        <span class="stock-dot"></span>
        {% if is_available %}{{ 'product.in_stock' | t }}{% else %}{{ 'product.low_stock' | t }}{% endif %}
      </span>
    </div>
  </div>

</div>
