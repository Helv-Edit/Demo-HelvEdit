<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% render 'meta-tags' %}
  {{ content_for_header }}

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Space+Grotesk:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Styles -->
  {{ 'pokevault.css' | asset_url | stylesheet_tag }}

  <!-- GSAP CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
</head>
<body>

  <!-- ═══ HEADER ═══ -->
  {% section 'header' %}

  <!-- ═══ MAIN CONTENT ═══ -->
  <main id="shopify-section-content">
    {{ content_for_layout }}
  </main>

  <!-- ═══ FOOTER ═══ -->
  {% section 'footer' %}

  <!-- ═══ CART DRAWER ═══ -->
  {% section 'cart-drawer' %}

  <!-- ═══ CLOUD TRANSITION (login/checkout only) ═══ -->
  {{ 'cloud-transition.js' | asset_url | script_tag }}

  <!-- ═══ GLOBAL SCRIPTS ═══ -->
  <script defer src="{{ 'pokevault-home.js' | asset_url }}"></script>
  <script defer src="{{ 'customer-pages.js' | asset_url }}"></script>
</body>
</html>
