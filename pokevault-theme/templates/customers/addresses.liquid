{% comment %}
  Customer addresses management page
{% endcomment %}

<div class="customer-addresses">
  <div class="page-header">
    <h1 class="page-title">Mes Adresses</h1>
    <a href="{{ routes.account_url }}" class="btn btn--back">← Retour au compte</a>
  </div>

  <div class="addresses-container">
    {% if customer.addresses.size > 0 %}
      <div class="addresses-grid">
        {% for address in customer.addresses %}
          <div class="address-item">
            <div class="address-content">
              <h3>{{ address.first_name }} {{ address.last_name }}</h3>
              <p>{{ address.street }}</p>
              {% if address.street2 %}<p>{{ address.street2 }}</p>{% endif %}
              <p>{{ address.city }} {{ address.zip }}</p>
              <p>{{ address.country }}</p>
              {% if address.phone %}<p>{{ address.phone }}</p>{% endif %}
              {% if address.default %}<span class="badge-default">Adresse par défaut</span>{% endif %}
            </div>
            <div class="address-actions">
              <a href="{{ address.edit_url }}" class="btn btn--small">Modifier</a>
              <a href="{{ address.delete_url }}" class="btn btn--small btn--danger" onclick="return confirm('Supprimer cette adresse ?')">Supprimer</a>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="empty">Aucune adresse enregistrée</p>
    {% endif %}

    <a href="{{ routes.account_addresses_url }}" class="btn btn--primary">+ Ajouter une adresse</a>
  </div>

</div>

<style>
  .customer-addresses {
    max-width: 900px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 203, 5, 0.2);
  }

  .page-title {
    font-family: var(--f-manga);
    font-size: 2rem;
    color: var(--yellow);
  }

  .addresses-container {
    background: rgba(22, 19, 16, 0.6);
    border: 1px solid rgba(255, 203, 5, 0.15);
    border-radius: 12px;
    padding: 2rem;
  }

  .addresses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .address-item {
    background: rgba(14, 12, 10, 0.5);
    border: 1px solid rgba(255, 203, 5, 0.2);
    border-radius: 8px;
    padding: 1.5rem;
    color: var(--white);
  }

  .address-content h3 {
    color: var(--yellow);
    margin-bottom: 0.75rem;
  }

  .address-content p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0.25rem 0;
  }

  .badge-default {
    display: inline-block;
    background: rgba(255, 203, 5, 0.2);
    color: var(--yellow);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-top: 0.75rem;
  }

  .address-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 203, 5, 0.1);
  }

  .btn--small {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  .btn--danger {
    background: rgba(220, 38, 38, 0.15);
    color: #dc2626;
    border: 1px solid rgba(220, 38, 38, 0.3);
  }

  .btn--danger:hover {
    background: rgba(220, 38, 38, 0.25);
  }

  .btn--back {
    background: transparent;
    color: var(--yellow);
    border: 1px solid rgba(255, 203, 5, 0.3);
  }

  .empty {
    text-align: center;
    color: var(--muted);
    padding: 2rem;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .addresses-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
